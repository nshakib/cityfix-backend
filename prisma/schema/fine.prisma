model Fine {
  id String @id @default(uuid())

  // Recipient
  recipientId  String?
  guestName    String?
  guestContact String?

  // Fine details
  categoryId  String
  complaintId String?
  issuedBy    String
  reason      String
  amount      Decimal
  evidence    String?
  status      FineStatus @default(ISSUED)

  // Payment
  paymentReference String?

  // Timestamps
  issuedAt  DateTime  @default(now())
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  recipient User?      @relation("FineRecipient", fields: [recipientId], references: [id])
  issuer    User       @relation("FineIssuer", fields: [issuedBy], references: [id])
  category  Category   @relation(fields: [categoryId], references: [id])
  complaint Complaint? @relation(fields: [complaintId], references: [id])

  // Dispute Fields (Added)
  disputeReason   String? // Why the citizen is disputing
  disputeEvidence String? // URL to photo/document
  disputedAt      DateTime? // When it was disputed

  reviewedBy String? // Admin ID who reviewed it
  reviewedAt DateTime? // When admin made the decision
  reviewNote String? // Admin's explanation for upholding/waiving

  statusLogs FineStatusLog[]
  payments   Payment[]
}
