model Notification {
  id String @id @default(uuid())

  userId String // The recipient (Citizen, Staff, or Admin)
  user   User   @relation(fields: [userId], references: [id], name: "UserNotifications")

  title   String
  message String
  type    NotificationType

  isRead Boolean @default(false)

  link String? // Optional: URL to the relevant complaint/fine

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}
